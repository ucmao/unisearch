{
  "name": "unisearch-desktop",
  "productName": "UniSearch",
  "version": "1.0.0",
  "description": "跨平台智能搜索与研究桌面应用",
  "author": "cheng wang",
  "main": "dist/main/index.js",
  "scripts": {
    "lint": "eslint src tests webui/src --max-warnings=0",
    "lint:fix": "eslint src tests webui/src --fix",
    "test:agent": "node tests/run-agent-tests.mjs",
    "probe:boss:cdp": "node --import tsx scratch/probe_boss_cdp.ts",
    "webui:build": "cd webui && npm run build",
    "build:backend": "tsup",
    "electron:dev": "npm run build:backend && electron .",
    "electron:build": "npm run build:backend && npm run webui:build && electron-builder",
    "electron:build:mac:release": "node scripts/check-release-platform.mjs darwin && node scripts/check-macos-notarization-env.mjs && npm run build:backend && npm run webui:build && electron-builder --mac --arm64 --config.mac.notarize=true --config.forceCodeSigning=true",
    "electron:build:win:release": "node scripts/check-release-platform.mjs win32 && npm run build:backend && npm run webui:build && electron-builder --win --x64 --config.win.signAndEditExecutable=true --config.forceCodeSigning=true",
    "verify:package": "node scripts/verify-packaged-runtime.mjs",
    "smoke:package": "node scripts/smoke-packaged-app.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "axios": "^1.7.9",
    "better-sqlite3": "^13.0.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "playwright": "1.61.1",
    "segmentit": "^2.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.9",
    "electron": "^42.7.1",
    "electron-builder": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.66.0"
  },
  "build": {
    "appId": "com.unisearch.app",
    "productName": "UniSearch",
    "files": [
      "dist/**/*",
      "api/webui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": ["**/*"]
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/icon-windows.png",
        "to": "build/icon-windows.png"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*",
      "dist/crawler/worker.js",
      "dist/processor/worker.js"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "notarize": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "UniSearch"
    }
  }
}
